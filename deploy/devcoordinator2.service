# DevCoordinator2 Rust daemon. Runs as root: PID 1 applies per-test identity
# through systemd-run --uid/--gid; governed commands remain in the separate
# non-root executor process (DecisionHistory DC2-2026-08-22-LAUNCH-MODE).
# Install-time steps (see docs/instance-configuration.md):
#   - create /etc/devcoordinator2/instance.env (root:CLIENT_GROUP, 0640)
#   - create the client group named there and add trusted accounts
[Unit]
Description=DevCoordinator2 coordinator daemon
After=network.target

[Service]
Type=exec
User=root
ExecStart=/home/DevCoordinator2/target/release/devcoordinator2 daemon
EnvironmentFile=-/etc/devcoordinator2/instance.env
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/home /var/lib/devcoordinator2 /run/devcoordinator2 /etc/devcoordinator2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
