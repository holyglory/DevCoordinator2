# Local-only installation artifacts — never committed.
# The committed repository must contain zero installation-specific data
# (domains, e-mail addresses, local account or group names, host paths,
# certificate locations). Those live in the untracked instance/ directory
# and in /etc (see docs/instance-configuration.md).
HANDOVER.md
instance/
.env
.env.*

# Development environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/
target/
*.log

# Local editor and runtime state
.DS_Store
.idea/
.vscode/
.claude/settings.local.json

# Local audit outputs and scratch runs
audit-output/
audit-outputs/
full-repo-audit-run/
tmp/

# Runtime state that must never enter the repository
.devcoordinator/

# Local Product Design visual targets may contain fixture or supplied identity data.
console/design-reference/

# Serena tool workspace (local-only)
.serena/
